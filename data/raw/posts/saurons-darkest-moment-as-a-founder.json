68d9-a3b1-4c0a-a9b8-98e92ac52f1c_3072x2048.jpeg&quot;,&quot;cover_image_alt&quot;:null,&quot;canonical_url&quot;:&quot;https://thefrontierpsychiatrists.substack.com/p/from-dark-lord-to-healthcare-innovator&quot;,&quot;section_name&quot;:&quot;The Lord of Liability&quot;,&quot;video_upload_id&quot;:null,&quot;id&quot;:104942614,&quot;type&quot;:&quot;newsletter&quot;,&quot;reaction_count&quot;:2,&quot;comment_count&quot;:2,&quot;publication_id&quot;:null,&quot;publication_name&quot;:&quot;The Frontier Psychiatrists &quot;,&quot;publication_logo_url&quot;:&quot;https://substackcdn.com/image/fetch/f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fbucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com%2Fpublic%2Fimages%2F997b8496-9b4d-43c2-b393-6f8a77945b00_1080x1080.png&quot;,&quot;belowTheFold&quot;:true,&quot;youtube_url&quot;:null,&quot;show_links&quot;:null,&quot;feed_url&quot;:null}\"></div><div class=\"digest-post-embed\" data-attrs=\"{&quot;nodeId&quot;:&quot;6a4d5c67-cdd4-46f1-8ae7-28b5b3ef8e17&quot;,&quot;caption&quot;:&quot;Editors note: what follows is yet another document unearthed after the fall of Sauron detailing the myriad HR and compliance issues that Mordor dealt with. Also Owen is on vacation this week so this up to the minute reporting of an imagined past should land just right.&quot;,&quot;cta&quot;:null,&quot;showBylines&quot;:true,&quot;showDescription&quot;:true,&quot;showImage&quot;:true,&quot;size&quot;:&quot;sm&quot;,&quot;isEditorNode&quot;:true,&quot;title&quot;:&quot;The Lord of the Rings Was An HR Nightmare&quot;,&quot;publishedBylines&quot;:[{&quot;id&quot;:2277375,&quot;name&quot;:&quot;Owen Scott Muir, M.D&quot;,&quot;bio&quot;:&quot;Dr. Owen Scott Muir is a healthcare innovator and entrepreneur, working across innovative care, payment models, technology, regulatory compliance, and education. He's a graduate of Amherst College.&quot;,&quot;photo_url&quot;:&quot;https://substackcdn.com/image/fetch/f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fbucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com%2Fpublic%2Fimages%2F1c03f44d-4506-4843-989f-0d38e66c6946_400x400.jpeg&quot;,&quot;is_guest&quot;:false,&quot;bestseller_tier&quot;:100}],&quot;post_date&quot;:&quot;2023-04-08T12:52:02.841Z&quot;,&quot;cover_image&quot;:&quot;https://substackcdn.com/image/fetch/f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F61aaef23-dd2d-4a87-9c49-eb1f4d57aca7_3072x2048.jpeg&quot;,&quot;cover_image_alt&quot;:null,&quot;canonical_url&quot;:&quot;https://thefrontierpsychiatrists.substack.com/p/the-lord-of-the-rings-was-an-hr-nightmare&quot;,&quot;section_name&quot;:&quot;The Lord of Liability&quot;,&quot;video_upload_id&quot;:null,&quot;id&quot;:113416642,&quot;type&quot;:&quot;newsletter&quot;,&quot;reaction_count&quot;:2,&quot;comment_count&quot;:0,&quot;publication_id&quot;:null,&quot;publication_name&quot;:&quot;The Frontier Psychiatrists &quot;,&quot;publication_logo_url&quot;:&quot;https://substackcdn.com/image/fetch/f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fbucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com%2Fpublic%2Fimages%2F997b8496-9b4d-43c2-b393-6f8a77945b00_1080x1080.png&quot;,&quot;belowTheFold&quot;:true,&quot;youtube_url&quot;:null,&quot;show_links&quot;:null,&quot;feed_url&quot;:null}\"></div><p>And there is even more.  I know, I know. <a href=\"https://thefrontierpsychiatrists.substack.com/s/the-palantir-of-the-discoverable\">It’s all here.</a></p><p>Also, RAMHT returns to LA on May 18th.  It’s held at the swanky <strong>Skyline Loft at 224 East 11th Street #601 Los Angeles, CA 90015.</strong></p><p class=\"button-wrapper\" data-attrs=\"{&quot;url&quot;:&quot;https://www.eventbrite.com/e/ramht-la-2025-tickets-1271647805819?utm-campaign=social&amp;utm-content=attendeeshare&amp;utm-medium=discovery&amp;utm-term=listing&amp;utm-source=cp&amp;aff=ebdsshcopyurl&quot;,&quot;text&quot;:&quot;Get your RAMHT Tickets Now!&quot;,&quot;action&quot;:null,&quot;class&quot;:&quot;button-wrapper&quot;}\" data-component-name=\"ButtonCreateButton\"><a class=\"button primary button-wrapper\" href=\"https://www.eventbrite.com/e/ramht-la-2025-tickets-1271647805819?utm-campaign=social&amp;utm-content=attendeeshare&amp;utm-medium=discovery&amp;utm-term=listing&amp;utm-source=cp&amp;aff=ebdsshcopyurl\"><span>Get your RAMHT Tickets Now!</span></a></p><div class=\"footnote\" data-component-name=\"FootnoteToDOM\"><a id=\"footnote-1\" href=\"#footnote-anchor-1\" class=\"footnote-number\" contenteditable=\"false\" target=\"_self\">1</a><div class=\"footnote-content\"><p>I know they were mistakes in spelling and grammar.   So I took what I wrote, and I put it into GPT4, and I had to rewrite it without the mistakes.</p><p>It feels kind of dead to me:</p><p>God, I know. Look, it's really hard. I had a plan. It was a really good plan, but it locked me in. I went hard on this one-ring thing. I know what you're thinking… can't you do anything else? Well, that's the point – I can't. I went all in. I made it all about one ring.</p><p>Honestly, I don't even know what the ring does. I mean, it makes other people invisible, which is definitely a superpower or something. And it makes me really powerful, or at least I think so. But it's just been so long. It's like I'm in withdrawal.</p><p>If I had any advice for the rest of Middle-earth, it would be: don't do what I did. If you're going to do something and you want to go big, at least make it possible to do something else next. Because of the one ring? It really locked me in on just that one thing. I had to deal with the one ring. I had to find it. You can't just make the most powerful ring, lose it, and not go after it. I think I shouldn't have even tried to make the one ring. Maybe I should have taken some of the other rings—redistributed rings, gone after some Elvish rings, I don't know, something. But having one ring really makes your entire thing about that one ring. There's no backup plan.</p><p>And today, I'm just not into it. I can't. I mean, I don't really have a choice because I built this giant eye situation for myself – it's just me and my minions endlessly searching for the ring. You get my point. It's ring, ring, ring, ring, ring. And frankly, I suck at it. My team found the ring at least three goddamn times. Did they get it any of those times? Did I get my ring back? No, that's not what happened. Frankly, I suck at it, not on Weathertop. It was right there. We suck at this. We suck so hard. I can't do anything right.</p><p>At least Smaug had different kinds of treasure to lounge on. I've got nothing. This thing, this thing that I made, this thing that I lost, it's everything. Without it? I'm nothing. It was just a bad choice. It was going to get lost, or someone would want to take it. I'm going to make a super powerful ring, and then someone's going to cut off my finger, which is exactly what happened. Stupid, stupid, stupid. I should have made like five rings, the five rings to control all the other rings, so that you could lose one or two, and it would still be fine. Maybe I should have just made the Orcs and given the rings a pass. I could have rolled the dice with orcs!</p><p>People really like multiple-time founders, but I'm a one-trick wonder. Honestly, I feel like a loser a lot of the time because I don't have a body anymore, and all I do is constantly look around. And what am I looking for? Yeah.</p><p>I want to go on vacation. I want to be able to take some quality time off. Maybe go to the Grey Havens, I don't know. Visit the Shire, something. God, I just can't. I don't want to. I don't have a lot of choice in the matter, but I just can't.</p><p>Sincerely,</p><p>Sauron.</p></div></div>","text":"God. I know.\n\nLook, it's really hard. I had a plan. It was a really good plan. But it locked me in.\n\nI went hard on this one-ring thing. I know what you're thinking… can't you just do anything?\n\nWell, that's the point. I can't. I went all in. I made it all about one ring.\n\nGod. To be honest, I don't even know what the ring does. I mean, it makes other people invisible. That's like a definite superpower or something. And it makes me really powerful, or at least I think so. But it's just been so long. It’s like I'm in withdrawal.\n\nIf I had any advice for the rest of middle earth, it would be don't do what I did. If you're going to do some thing, and you wanna go big, at least make it possible to do something else next .\n\nBecause the one ring? It really locked me in on just like that one thing. I had to deal with the one ring. I had to find it. You can't just make the most powerful ring and lose it and then not go after it . I think I should not have even tried to make the one ring. Maybe I should have taken some of the rings?’ Redistributed rings. Go after some Elvish rings; I don't know, something. But having one ring really makes your entire thing all about rings, and all about one ring. There is no backup plan.\n\nAnd today, I'm just not into it. I can't. I mean, I don't really have a choice cause I built this giant eye situation for myself— it's just me and mine endlessly searching for the ring. You get my point. It's ring ring ring ring ring. And frankly, I suck at it. My team found the ring at least three goddamn times. Did they get it any of those times? Did I get my ring back? No. That's not what happened. Frankly, I suck at it, not on Weather Top. It was right there. We suck at this. We suck so hard. I can't do anything right.\n\nSubscribe now\n\nAt least Smaug had different kinds of treasure to lounge on. I've got fuck all.\n\nThis thing, this thing that I made, this thing that I lost, it's everything. Without it? I'm nothing. It was just a bad choice. It was going to get lost, or someone was going to want to take it. I'm gonna make a super powerful ring. And then someone's going to cut off my fucking finger. Which is exactly what happened. Stupid, stupid, stupid.\n\nI should've made five rings. The five rings control all the other rings, so you can lose one or two, and it'll still be fine.\n\nMaybe I should've just made the Orcs and given the rings a fucking pass? I could have just rolled the dice in with orcs?!\n\nPeople really like multiple-time founders, but I'm a one-trick wonder. Honestly, I feel like a loser a lot of the time. Because I don't have a body anymore, and all I do is constantly look around. And what am I looking for, yeah?\n\nI want to go on vacation. I want to be able to take some quality time off. Maybe go to the Gray Havens. I don't know. Visit the Shire. Something. God, I just. I just can't. I don't want to. I don't have a lot of choice in this matter. But I just can't.\n\nSincerely,\n\nSauron. 1\n\nShare The Frontier Psychiatrists\n\nOther LOTR-themed hits include:\n\nAnd there is even more. I know, I know. It’s all here.\n\nAlso, RAMHT returns to LA on May 18th. It’s held at the swanky Skyline Loft at 224 East 11th Street #601 Los Angeles, CA 90015.\n\nGet your RAMHT Tickets Now!\n\n1 I know they were mistakes in spelling and grammar. So I took what I wrote, and I put it into GPT4, and I had to rewrite it without the mistakes.\n\nIt feels kind of dead to me:\n\nGod, I know. Look, it's really hard. I had a plan. It was a really good plan, but it locked me in. I went hard on this one-ring thing. I know what you're thinking… can't you do anything else? Well, that's the point – I can't. I went all in. I made it all about one ring.\n\nHonestly, I don't even know what the ring does. I mean, it makes other people invisible, which is definitely a superpower or something. And it makes me really powerful, or at least I think so. But it's just been so long. It's like I'm in withdrawal.\n\nIf I had any advice for the rest of Middle-earth, it would be: don't do what I did. If you're going to do something and you want to go big, at least make it possible to do something else next. Because of the one ring? It really locked me in on just that one thing. I had to deal with the one ring. I had to find it. You can't just make the most powerful ring, lose it, and not go after it. I think I shouldn't have even tried to make the one ring. Maybe I should have taken some of the other rings—redistributed rings, gone after some Elvish rings, I don't know, something. But having one ring really makes your entire thing about that one ring. There's no backup plan.\n\nAnd today, I'm just not into it. I can't. I mean, I don't really have a choice because I built this giant eye situation for myself – it's just me and my minions endlessly searching for the ring. You get my point. It's ring, ring, ring, ring, ring. And frankly, I suck at it. My team found the ring at least three goddamn times. Did they get it any of those times? Did I get my ring back? No, that's not what happened. Frankly, I suck at it, not on Weathertop. It was right there. We suck at this. We suck so hard. I can't do anything right.\n\nAt least Smaug had different kinds of treasure to lounge on. I've got nothing. This thing, this thing that I made, this thing that I lost, it's everything. Without it? I'm nothing. It was just a bad choice. It was going to get lost, or someone would want to take it. I'm going to make a super powerful ring, and then someone's going to cut off my finger, which is exactly what happened. Stupid, stupid, stupid. I should have made like five rings, the five rings to control all the other rings, so that you could lose one or two, and it would still be fine. Maybe I should have just made the Orcs and given the rings a pass. I could have rolled the dice with orcs!\n\nPeople really like multiple-time founders, but I'm a one-trick wonder. Honestly, I feel like a loser a lot of the time because I don't have a body anymore, and all I do is constantly look around. And what am I looking for? Yeah.\n\nI want to go on vacation. I want to be able to take some quality time off