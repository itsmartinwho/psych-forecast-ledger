eteer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com%2Fpublic%2Fimages%2F1c03f44d-4506-4843-989f-0d38e66c6946_400x400.jpeg&quot;,&quot;is_guest&quot;:false,&quot;bestseller_tier&quot;:100}],&quot;post_date&quot;:&quot;2024-03-30T16:29:02.049Z&quot;,&quot;cover_image&quot;:&quot;https://substackcdn.com/image/fetch/$s_!6B23!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fd003dc07-6ffe-4adb-beb1-aec82dd039a0.heic&quot;,&quot;cover_image_alt&quot;:null,&quot;canonical_url&quot;:&quot;https://thefrontierpsychiatrists.substack.com/p/nutritional-ketosis-for-bipolar-disorder&quot;,&quot;section_name&quot;:null,&quot;video_upload_id&quot;:null,&quot;id&quot;:143102060,&quot;type&quot;:&quot;newsletter&quot;,&quot;reaction_count&quot;:14,&quot;comment_count&quot;:9,&quot;publication_id&quot;:355550,&quot;publication_name&quot;:&quot;The Frontier Psychiatrists &quot;,&quot;publication_logo_url&quot;:&quot;https://substackcdn.com/image/fetch/$s_!oO3w!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fbucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com%2Fpublic%2Fimages%2F997b8496-9b4d-43c2-b393-6f8a77945b00_1080x1080.png&quot;,&quot;belowTheFold&quot;:true,&quot;youtube_url&quot;:null,&quot;show_links&quot;:null,&quot;feed_url&quot;:null}\"></div><div class=\"digest-post-embed\" data-attrs=\"{&quot;nodeId&quot;:&quot;2a4885dc-f3d7-496c-bad3-79341e62910c&quot;,&quot;caption&quot;:&quot;I don't drink. I don't smoke. I use drugs. I never have. I also have bipolar disorder. These decisions about life are related. The fact that I enjoy, in theory, being correct is tempered by the grim reality for so many people who are not me. Alcohol is dumpster-fire lighting life choice for those with bipolar disorder. Welcome to&quot;,&quot;cta&quot;:null,&quot;showBylines&quot;:true,&quot;showDescription&quot;:true,&quot;showImage&quot;:true,&quot;size&quot;:&quot;md&quot;,&quot;isEditorNode&quot;:true,&quot;title&quot;:&quot;Alcohol is Bad Medicine in Bipolar Disorder&quot;,&quot;publishedBylines&quot;:[{&quot;id&quot;:2277375,&quot;name&quot;:&quot;Owen Scott Muir, M.D.&quot;,&quot;bio&quot;:&quot;Dr. Owen Scott Muir, M.D., DFAACAP is the Chief Medical Officer of Radial &amp; Neurolief. He's a graduate of Amherst College, Child, Adolescent, and Adult Psychiatrist, and a prolific writer and podcaster. https://www.meetradial.com for more.&quot;,&quot;photo_url&quot;:&quot;https://substackcdn.com/image/fetch/f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fbucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com%2Fpublic%2Fimages%2F1c03f44d-4506-4843-989f-0d38e66c6946_400x400.jpeg&quot;,&quot;is_guest&quot;:false,&quot;bestseller_tier&quot;:100}],&quot;post_date&quot;:&quot;2024-08-27T13:01:48.628Z&quot;,&quot;cover_image&quot;:&quot;https://substackcdn.com/image/fetch/f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F97f626e2-6d75-479a-8c54-12daa9a7db20_4032x3024.jpeg&quot;,&quot;cover_image_alt&quot;:null,&quot;canonical_url&quot;:&quot;https://thefrontierpsychiatrists.substack.com/p/alcohol-is-bad-medicine-in-bipolar&quot;,&quot;section_name&quot;:null,&quot;video_upload_id&quot;:null,&quot;id&quot;:147823703,&quot;type&quot;:&quot;newsletter&quot;,&quot;reaction_count&quot;:7,&quot;comment_count&quot;:0,&quot;publication_id&quot;:355550,&quot;publication_name&quot;:&quot;The Frontier Psychiatrists &quot;,&quot;publication_logo_url&quot;:&quot;https://substackcdn.com/image/fetch/$s_!oO3w!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fbucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com%2Fpublic%2Fimages%2F997b8496-9b4d-43c2-b393-6f8a77945b00_1080x1080.png&quot;,&quot;belowTheFold&quot;:true,&quot;youtube_url&quot;:null,&quot;show_links&quot;:null,&quot;feed_url&quot;:null}\"></div><div class=\"digest-post-embed\" data-attrs=\"{&quot;nodeId&quot;:&quot;ee66a145-8b5f-4781-b9f6-85953afb1f75&quot;,&quot;caption&quot;:&quot;The Frontier Psychiatrists is a health-themed newsletter. This article is both scientific and personal. It’s about circadian rhythms and whatever bipolar disorder turns out to be. I will use Manic-Depressive Illness and Bipolar Disorder interchangeably in this writing… please consider subscribing! I am trying to stick the landing with a resource se…&quot;,&quot;cta&quot;:null,&quot;showBylines&quot;:true,&quot;showDescription&quot;:true,&quot;showImage&quot;:true,&quot;size&quot;:&quot;md&quot;,&quot;isEditorNode&quot;:true,&quot;title&quot;:&quot;Is Bipolar Disorder a Circadian Rhythm Disorder? &quot;,&quot;publishedBylines&quot;:[{&quot;id&quot;:2277375,&quot;name&quot;:&quot;Owen Scott Muir, M.D.&quot;,&quot;bio&quot;:&quot;Dr. Owen Scott Muir, M.D., DFAACAP is the Chief Medical Officer of Radial &amp; Neurolief. He's a graduate of Amherst College, Child, Adolescent, and Adult Psychiatrist, and a prolific writer and podcaster. https://www.meetradial.com for more.&quot;,&quot;photo_url&quot;:&quot;https://substackcdn.com/image/fetch/f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fbucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com%2Fpublic%2Fimages%2F1c03f44d-4506-4843-989f-0d38e66c6946_400x400.jpeg&quot;,&quot;is_guest&quot;:false,&quot;bestseller_tier&quot;:100}],&quot;post_date&quot;:&quot;2023-10-23T11:00:38.942Z&quot;,&quot;cover_image&quot;:&quot;https://substackcdn.com/image/fetch/$s_!5CBi!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5ed5cb0d-7d6c-44c9-ace9-858d449b25ae_1704x1368.png&quot;,&quot;cover_image_alt&quot;:null,&quot;canonical_url&quot;:&quot;https://thefrontierpsychiatrists.substack.com/p/bipolar-disorder-might-be-a-circadian&quot;,&quot;section_name&quot;:null,&quot;video_upload_id&quot;:null,&quot;id&quot;:137924065,&quot;type&quot;:&quot;newsletter&quot;,&quot;reaction_count&quot;:16,&quot;comment_count&quot;:0,&quot;