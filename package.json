{
  "name": "psych-forecast-ledger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/validate.ts && tsx scripts/check-drift.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "check-drift": "tsx scripts/check-drift.ts",
    "check-pages": "tsx scripts/check-pages.ts",
    "data:archive": "tsx scripts/fetch-archive.ts",
    "data:posts": "tsx scripts/fetch-posts.ts",
    "data:receiver": "tsx scripts/paid-receiver.ts",
    "data:coverage": "tsx scripts/coverage.ts"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
